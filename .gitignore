# Rust
target/
**/*.rs.bk

# Per-worktree cargo target-dir override written by `just worktree`, pinning
# the worktree to its own target/ so concurrent worktree builds cannot thrash
# a machine-level shared target-dir config.
/.cargo/

# Node
node_modules/
dist/
.vite/

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Private harness state. Not project-shared. Each entry is one agent harness's
# install location for the same personal tooling; the repository depends on
# none of them. The lone reference to an agent skill, frontend's advisory
# `detect` hook, calls a globally installed binary, not a vendored copy here.
.claude
.agents
.codex
.github/hooks
.github/skills

# Docs build output
docs/.astro/

# Drift-check temp copy of the generated just reference
# (scripts/gen-just-reference.sh --check)
docs/gen-just-reference.check.mdx

# Test coverage
coverage/
*.lcov
# Private design, planning, and evaluation artifacts.
/plans/

# Dev library seed target (populated by scripts/seed-library.sh when
# REVERIE_LIBRARY_PATH is unset)
backend/tests/fixtures/library/

# Gemini CLI security scanner scratch directory (mid-run temp files;
# security_report.json persists when --json is requested)
.gemini_security/

# Playwright MCP scratch (snapshots, console logs) + agent screenshot scratch
.playwright-mcp/
d2-*.png

# Personal agent-workflow tooling — kept local, not project-shared
SDL.md

# Impeccable working directory: critique and polish screenshots, live-mode
# session and preview state, runtime caches, per-developer config. Ignored
# whole rather than file by file, so runtime files added by a future version
# stay ignored by default instead of appearing in `git status` as candidates
# for an accidental commit. The `**/` prefix is load-bearing: a pattern with
# a slash anywhere but the end is anchored to this file's directory, so a
# bare `.impeccable/` would miss `frontend/.impeccable/`, which is where the
# design-showcase runs put it.
#
# To track a shared artifact later, switch to the contents form
# (`**/.impeccable/**` plus negations). Negating a path under an ignored
# directory does not work: git never descends into it to see the exception.
**/.impeccable/

# Background backend dev-server artifacts (just rust::dev-start); backend has
# no plane-local gitignore, so they are listed here.
backend/.dev-server.pid
backend/.dev-server.lock
backend/.dev-server.log

# User library/ingestion/quarantine data, when a dev override points a config
# path (REVERIE_LIBRARY_PATH etc.) inside the checkout instead of at the
# shipped /data/* container default. Keeps user-uploaded content out of
# commits regardless of where a developer points those paths.
backend/library/
backend/ingestion/
backend/quarantine/

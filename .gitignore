# Rust
target/
**/*.rs.bk

# Node
node_modules/
dist/
.vite/

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Claude Code runtime locks + per-user local settings
.claude/*.lock
.claude/settings.local.json

# Docs build output
docs/.astro/

# Test coverage
coverage/
*.lcov
/plans/

# Dev library seed target (populated by dev/seed-library.sh when
# REVERIE_LIBRARY_PATH is unset)
backend/tests/fixtures/library/

# Gemini CLI security scanner scratch directory (mid-run temp files;
# security_report.json persists when --json is requested)
.gemini_security/

# Playwright MCP scratch (snapshots, console logs) + agent screenshot scratch
.playwright-mcp/
d2-*.png

# graphify — output is fully regenerated from code on every commit; no value
# tracking it for a solo project. Always gitignore the entire directory.
graphify-out/
.graphifyignore

# Personal agent-workflow tooling — kept local, not project-shared
SDL.md

# graphify also installs per-developer git hooks under .husky/. They are
# local-only (each contributor opts into graphify) and not project-shared,
# so they shouldn't be tracked.
.husky/post-checkout
.husky/post-commit

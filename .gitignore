# Rust
target/
**/*.rs.bk

# Per-worktree cargo target-dir override written by `just worktree`, pinning
# the worktree to its own target/ so concurrent worktree builds cannot thrash
# a machine-level shared target-dir config.
/.cargo/

# Node
node_modules/
dist/
.vite/

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Private harness state, except for the shared Playwright CLI skill below.
# Frontend's advisory `detect` hook still calls its globally installed skill.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/playwright-cli
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/playwright-cli/
.codex
.github/hooks
.github/skills

# Private design, planning, and evaluation artifacts.
/plans/

# Dev library seed target (populated by scripts/seed-library.sh when
# REVERIE_LIBRARY_PATH is unset)
backend/tests/fixtures/library/

# Gemini CLI security scanner scratch directory (mid-run temp files;
# security_report.json persists when --json is requested)
.gemini_security/

# Playwright MCP scratch (snapshots, console logs) + agent screenshot scratch
.playwright-mcp/
.playwright/
.playwright-cli/
d2-*.png

# Personal agent-workflow tooling — kept local, not project-shared
SDL.md

# impeccable-ignore-start
# Ignore runtime state at every workspace depth; shared design artifacts remain tracked.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end

# Background backend dev-server artifacts (just rust::dev-start); backend has
# no plane-local gitignore, so they are listed here.
backend/.dev-server.pid
backend/.dev-server.lock
backend/.dev-server.log

# User library/ingestion/quarantine data, when a dev override points a config
# path (REVERIE_LIBRARY_PATH etc.) inside the checkout instead of at the
# shipped /data/* container default. Keeps user-uploaded content out of
# commits regardless of where a developer points those paths.
backend/library/
backend/ingestion/
backend/quarantine/
.npmrc

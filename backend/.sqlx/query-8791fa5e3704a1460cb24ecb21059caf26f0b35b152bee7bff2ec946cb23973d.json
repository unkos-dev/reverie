{
  "db_name": "PostgreSQL",
  "query": "INSERT INTO manifestations (work_id, format, file_path, ingestion_file_hash, current_file_hash, file_size_bytes, ingestion_status, validation_status, accessibility_metadata) VALUES ($1, $2, $3, $4, $4, $5, $6, $7, $8) RETURNING id",

  "query": "SELECT a.id, CASE WHEN octet_length(a.name) > $3 THEN NULL WHEN octet_length(to_jsonb(a.name)::text) > $3 THEN NULL ELSE a.name END AS name, 'contributors.' || wa.role::text AS \"field!\", wa.position, wa.source_version_id FROM work_authors wa JOIN authors a ON a.id = wa.author_id WHERE wa.work_id = $1 AND 'contributors.' || wa.role::text = ANY($2) ORDER BY wa.role, wa.position, a.id LIMIT $4",

  "query": "SELECT v.id, v.source, v.field_name, v.new_value AS \"value!\", v.match_type, v.submitted_by FROM metadata_versions v JOIN jsonb_to_recordset($1::jsonb) AS expected(id uuid, source text, field_name text, value jsonb, match_type text, submitted_by uuid) ON v.id = expected.id AND v.source = expected.source AND v.field_name = expected.field_name AND v.new_value = coalesce(expected.value, 'null'::jsonb) AND v.match_type = expected.match_type AND v.submitted_by IS NOT DISTINCT FROM expected.submitted_by ORDER BY v.id LIMIT $2 FOR SHARE OF v",

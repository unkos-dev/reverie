{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id          AS \"id!\",\n               s.name        AS \"name!\",\n               s.is_system   AS \"is_system!\",\n               s.created_at  AS \"created_at!\",\n               s.updated_at  AS \"updated_at!\",\n               (SELECT COUNT(*) FROM shelf_items si WHERE si.shelf_id = s.id)\n                             AS \"item_count!\"\n          FROM shelves s\n         WHERE s.user_id = $1\n         ORDER BY s.is_system DESC, s.name ASC\n        ",

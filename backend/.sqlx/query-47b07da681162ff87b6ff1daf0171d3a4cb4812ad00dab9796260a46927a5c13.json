  "query": "SELECT wa.work_id, a.name, wa.role AS \"role: ContributorRole\"\n           FROM work_authors wa\n           JOIN authors a ON a.id = wa.author_id\n           WHERE wa.work_id = ANY($1::uuid[]) AND wa.role <> 'author'\n           ORDER BY wa.role ASC, wa.position ASC",

  "query": "\n        SELECT s.id, s.name, s.is_system, s.created_at, s.updated_at,\n          (SELECT COUNT(*) FROM shelf_items si WHERE si.shelf_id = s.id) AS \"item_count!\"\n        FROM shelves s WHERE s.id = ANY($1::uuid[]) AND s.user_id = $2\n    ",

{
  "private": true,
  "name": "reverie-dev",
  "description": "Development tooling for Reverie",
  "workspaces": [
    "frontend",
    "docs"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "vp run -r build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "lefthook": "2.1.10",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "^0.23.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "markdown-it": "14.3.0",
    "vite": "$vite",
    "vitest": "4.1.10",
    "ip-address": "^10.2.0",
    "form-data": "4.0.6"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "header-max-length": [
        2,
        "always",
        100
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lefthook@2.1.10": true,
    "puppeteer@25.3.0": true
  }
}

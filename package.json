{
  "private": true,
  "name": "reverie-dev",
  "description": "Development tooling for Reverie",
  "engines": {
    "node": ">=24.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare": "test ! -e .git || lefthook install",
    "build": "vp run -r build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "lefthook": "2.1.12",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "^0.23.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "header-max-length": [
        2,
        "always",
        100
      ]
    }
  }
}

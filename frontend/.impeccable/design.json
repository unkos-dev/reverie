      "description": "The main action in the owning flow.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Add to shelf</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:34px;padding:0 12px;border:1px solid var(--hairline,rgb(160 180 255 / 13%));border-radius:9px;font-size:14px;font-weight:500;cursor:pointer;transition:background-color 180ms,color 180ms;font-family:var(--font-body,\"Mona Sans\",system-ui,sans-serif);background:var(--accent,#8fa8ff);color:var(--fg-on-accent,#070b1a);}.ds-button-primary:hover{background:var(--accent-strong,#849df3);}.ds-button-primary:active{background:var(--accent-strong,#849df3);}.ds-button-primary:focus-visible{outline:1.5px solid var(--focus-ring,#98b1ff);outline-offset:0;box-shadow:0 0 0 5px var(--focus-halo,rgb(143 168 255 / 10.5%));}.ds-button-primary:disabled{opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"

      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a class=\"ds-nav-link\" href=\"#library\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m16 6 4 14M12 4v16M8 8v12M4 4v16\"/></svg>Library</a><a class=\"ds-nav-link\" href=\"#shelves\">Shelves</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;width:max-content;padding:6px;border:1px solid var(--hairline,rgb(160 180 255 / 13%));border-radius:16px;background:var(--bar,rgb(255 255 255 / 4.5%));backdrop-filter:blur(22px);}.ds-nav-link{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:1px solid transparent;border-radius:9px;color:var(--fg-muted,#b0b4c1);text-decoration:none;font-size:14px;font-weight:500;transition:background-color 180ms;font-family:var(--font-body,\"Mona Sans\",system-ui,sans-serif);}.ds-nav-link:hover{background:var(--bar-raised,#d3d6f10e);color:var(--fg,#eef1fa);}.ds-nav-link[aria-current=\"page\"]{background:var(--bar-raised,#d3d6f10e);border-color:var(--bar-raised-border,#787c88);color:var(--fg,#eef1fa);}.ds-nav-link:focus-visible{outline:1.5px solid var(--focus-ring,#98b1ff);outline-offset:0;box-shadow:0 0 0 5px var(--focus-halo,rgb(143 168 255 / 10.5%));}:host-context([data-theme=\"light\"]) .ds-nav-link[aria-current=\"page\"]{background:var(--surface-2,#dde4fa);border-color:var(--border-control,#6f7dac);}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none;}}"

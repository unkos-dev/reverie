{
  "src": "./src",
  "schema": "../backend/schema.graphql",
  "language": "typescript",
  "artifactDirectory": "./src/lib/relay/__generated__",
  "eagerEsModules": true,
  "customScalarTypes": {
    "JSON": "unknown",
    "ETag": "string",
    "UUID": "string",
    "DateTime": "string"
  },
  "requireCustomScalarTypes": true,
  "persistConfig": {
    "file": "../backend/graphql-documents.json",
    "algorithm": "SHA256"
  },
  "noSourceControl": true
}

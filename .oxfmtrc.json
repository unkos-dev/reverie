{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "target/",
    "node_modules/",
    "dist/",
    "docs/.astro/",
    "CHANGELOG.md",
    "backend/.sqlx/",
    "frontend/src/components/ui/",
    ".claude/",
    "docs/security/codeguard/",
    "frontend/a11y-results.json",
    "backend/config.schema.json",
    "docs/src/content/docs/reference/configuration.mdx",
    "docs/openapi.json"
  ]
}

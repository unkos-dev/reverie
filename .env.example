# The backend never discovers this or any other env file itself; it reads
# only the process environment. For local dev, copy this file to
# ~/reverie/dev/env (or point REVERIE_DEV_ENV at another location); the
# rust plane's dev recipes source it via scripts/backend-dev-env.sh. For a
# deployment, feed the same variables through your deployment tooling
# instead (see docker/staging.env.*.example for the container topology).

# --- Database ---
# Ports: docker/compose.dev.yml maps postgres to loopback-only 127.0.0.1:5432.

# Web application runtime (RLS enforced, user-scoped read filtering)
DATABASE_URL=postgres://reverie_app:reverie_app@localhost:5432/reverie_dev

# Background ingestion pipeline (permissive RLS, scoped table access)
# Used by the ingestion/enrichment workers (Steps 4-8).
# DATABASE_URL_INGESTION=postgres://reverie_ingestion:reverie_ingestion@localhost:5432/reverie_dev

# Migrations — dedicated least-privilege role (reverie_migrator: NOSUPERUSER,
# NOBYPASSRLS). This DSN is consumed by the `reverie migrate` subcommand (the
# shipped default — run out-of-band) and, only when REVERIE_AUTO_MIGRATE=true
# below, by the in-process startup path. With the flag off, the server does
# NOT read this value, so the default verify-only path carries no migration
# credential.
#
# PRODUCTION: set this ONLY on the one-shot migrate job/sidecar (or wherever you
# run `reverie migrate`) — do NOT put it on the long-lived app service's env,
# where it would sit unused in an internet-exposed process. Use strong, unique
# credentials distinct from this dev example. This dev value is fine here
# because dev runs `just rust::migrate`, which sources this file.
# See adr/2026-06-02-hybrid-migration-entrypoints-and-role.md.
DATABASE_URL_MIGRATION=postgres://reverie_migrator:reverie_migrator@localhost:5432/reverie_dev

# Run pending migrations in-process at server startup. Default false: the
# shipped model migrates out-of-band so the long-lived server never carries
# the migration credential. With it OFF, `cargo run` (or the server binary)
# only VERIFIES the schema is current and refuses to start on any divergence —
# run `cargo run -- migrate` (dev) / `reverie migrate` (prod) first. Set true
# only if you accept the server process holding DATABASE_URL_MIGRATION for its
# whole lifetime; when true, DATABASE_URL_MIGRATION is required at startup.
# REVERIE_AUTO_MIGRATE=false

# --- Paths ---
# REVERIE_LIBRARY_PATH=/data/library
# Also used by scripts/seed-library.sh as the directory it seeds with
# Standard Ebooks fixtures, so seed + scan agree on a single path.
# REVERIE_INGESTION_PATH=/data/ingestion
# REVERIE_QUARANTINE_PATH=/data/quarantine

# --- Ingestion Pipeline ---
# Comma-separated format priority (highest first). Default: epub,pdf,mobi,azw3,cbz,cbr
# REVERIE_FORMAT_PRIORITY=epub,pdf,mobi,azw3,cbz,cbr

# What to delete from the ingestion directory after a successful batch.
#   all      — delete all files (including non-selected formats) [default]
#   ingested — delete only files that were actually ingested
#   none     — never delete source files (manual cleanup)
# REVERIE_CLEANUP_MODE=all

# --- Authentication ---
# Reverie supports local email+password accounts and/or OIDC. At least one must
# be usable or the server refuses to start.

# Local email+password login (default true). If set false, OIDC must be
# configured below.
# REVERIE_LOCAL_AUTH_ENABLED=true

# Minimum local-account password length (NIST SP 800-63B floor; minimum 8).
# REVERIE_PASSWORD_MIN_LENGTH=8

# Maximum local-account password length, in characters (minimum 64). A
# denial-of-service cap on the unauthenticated registration path, not a
# composition rule.
# REVERIE_PASSWORD_MAX_LENGTH=256

# Minimum zxcvbn strength score, 0..=4. A candidate scoring below this is
# rejected as too weak, with the estimator's feedback returned in the response.
# REVERIE_PASSWORD_MIN_ZXCVBN_SCORE=2

# HIBP Pwned Passwords breach check at credential-setting time (default true).
# Fails open: a HIBP outage never blocks account creation or login. Set false to
# skip the outbound request entirely (e.g. fully offline instances). Only the
# 5-character SHA-1 prefix leaves the process (k-anonymity).
# REVERIE_PASSWORD_BREACH_CHECK_ENABLED=true
# REVERIE_PASSWORD_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range

# Self-service account registration (default false). When off, /auth/register
# returns 404. A self-registered account is always a non-admin, non-child Adult.
# REVERIE_SELF_REGISTRATION_ENABLED=false

# Per-source (per-IP) login/recovery attempts allowed per minute.
# REVERIE_LOGIN_RATE_PER_MIN=10

# Per-account failed-login backoff (seconds): the base delay doubles per
# consecutive failure up to the cap. A correct password is never blocked.
# REVERIE_LOGIN_THROTTLE_BASE_SECS=2
# REVERIE_LOGIN_THROTTLE_CAP_SECS=900

# Forgot-password recovery PIN lifetime (seconds) and the operator-readable
# directory it is written into (one mode-0600 file per user at
# <dir>/<user_id>.pin). MUST be outside any web-served path; the database stores
# only the PIN's hash.
# REVERIE_RECOVERY_PIN_TTL_SECS=900
# REVERIE_RECOVERY_PIN_DIR=/data/recovery-pins

# Forwarded-for header to trust for the client IP behind a reverse proxy. Unset
# by default (the TCP peer is used). An unauthenticated forwarded header is
# spoofable, so set this only when a trusted proxy populates it.
# REVERIE_TRUSTED_CLIENT_IP_HEADER=X-Forwarded-For

# OIDC (optional). Set OIDC_ISSUER_URL to enable it; the other three are then
# required together.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/reverie/
# OIDC_CLIENT_ID=reverie
# OIDC_CLIENT_SECRET=your-client-secret-here
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# --- First-run bootstrap (optional headless first-admin seed) ---
# Create the first administrator at startup if none exists. All three must be
# set together; ignored once any admin exists. The interactive alternative is
# the /setup screen on first run.
# REVERIE_BOOTSTRAP_EMAIL=admin@example.com
# REVERIE_BOOTSTRAP_PASSWORD=change-me-on-first-login
# REVERIE_BOOTSTRAP_DISPLAY_NAME=Administrator

# --- Metadata Enrichment Pipeline (Step 7) ---
# Toggle the enrichment queue worker. When disabled, ingested manifestations
# still land in enrichment_status='pending' but are never claimed.
# REVERIE_ENRICHMENT_ENABLED=true

# Max concurrent per-manifestation enrichment runs. Range 1–10.
# REVERIE_ENRICHMENT_CONCURRENCY=2

# Queue poll cadence (seconds) when there is nothing to claim.
# REVERIE_ENRICHMENT_POLL_IDLE_SECS=30

# Wall-clock budget for the parallel fan-out to all enabled sources.
# REVERIE_ENRICHMENT_FETCH_BUDGET_SECS=15

# Per-provider HTTP timeout (seconds).
# REVERIE_ENRICHMENT_HTTP_TIMEOUT_SECS=10

# Maximum retry attempts before a manifestation is marked 'skipped'.
# REVERIE_ENRICHMENT_MAX_ATTEMPTS=10

# Per-kind TTLs for api_cache rows.
# REVERIE_ENRICHMENT_CACHE_TTL_HIT_DAYS=30
# REVERIE_ENRICHMENT_CACHE_TTL_MISS_DAYS=7
# REVERIE_ENRICHMENT_CACHE_TTL_ERROR_MINS=15

# --- Cover Download Pipeline ---
# Hard byte cap per cover download; streaming abort mid-body on overrun.
# REVERIE_COVER_MAX_BYTES=10485760

# Total download timeout (seconds).
# REVERIE_COVER_DOWNLOAD_TIMEOUT_SECS=30

# Minimum long-edge in pixels after decode; smaller covers are rejected.
# REVERIE_COVER_MIN_LONG_EDGE_PX=1000

# Cover download HTTP redirect hop limit (SSRF-guarded at each hop).
# REVERIE_COVER_REDIRECT_LIMIT=3

# --- Metadata Writeback Pipeline (Step 8) ---
# Toggle the writeback worker. When disabled, writeback_jobs rows accumulate
# in 'pending' but are never claimed.
# REVERIE_WRITEBACK_ENABLED=true

# Max concurrent writeback jobs (per-manifestation serialisation is enforced
# by the claim CTE regardless of this setting). Range 1–10.
# REVERIE_WRITEBACK_CONCURRENCY=2

# Queue poll cadence (seconds). Lower value makes writeback feel
# near-real-time after an accept; higher reduces idle-system CPU.
# REVERIE_WRITEBACK_POLL_IDLE_SECS=5

# Maximum retry attempts before a job is marked 'skipped' (terminal).
# REVERIE_WRITEBACK_MAX_ATTEMPTS=10

# --- Metadata Provider Endpoints ---
# Override for testing / mirrors. Leave unset to use the public endpoints.
# REVERIE_OPENLIBRARY_BASE_URL=https://openlibrary.org
# REVERIE_GOOGLEBOOKS_BASE_URL=https://www.googleapis.com/books/v1
# Google Books allows 1000 anon req/day; add a key to raise the quota.
# REVERIE_GOOGLEBOOKS_API_KEY=
# REVERIE_HARDCOVER_BASE_URL=https://api.hardcover.app/v1/graphql
# Hardcover auto-disables when this is unset.
# REVERIE_HARDCOVER_API_TOKEN=

# STRONGLY RECOMMENDED.  Operator contact (email or URL) advertised in the
# outbound `User-Agent` header.  OpenLibrary grants identified requests
# 3 req/s — three times the 1 req/s anonymous tier — so leaving this unset
# triples your enrichment runtime against OpenLibrary.  The reverie backend
# emits a startup warning if absent.
REVERIE_OPERATOR_CONTACT=you@example.com

# --- OPDS Catalog (Step 9) ---
# When enabled, mounts /opds/* behind a Basic-only extractor. The Basic
# username is the device-token id prefixed with the token prefix
# (`{prefix}{token_id}`) and the password is the token secret. Feeds and
# downloads emit absolute URLs rooted at REVERIE_PUBLIC_URL, required when
# OPDS is enabled.
REVERIE_OPDS_ENABLED=true
REVERIE_OPDS_PAGE_SIZE=50
REVERIE_OPDS_REALM=Reverie OPDS
REVERIE_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Security headers (UNK-106)
# ---------------------------------------------------------------------------
# Absolute path to the built frontend dist directory. When set, the backend
# serves /assets/* and falls back to index.html for SPA routes. When unset,
# the backend runs API-only (dev mode — Vite serves the HTML).
# The prod Dockerfile defaults this to /srv/frontend.
REVERIE_FRONTEND_DIST_PATH=

# CSP violation-reporting endpoint. Must be absolute http(s) URL.
# When set, CSP advertises report-to + report-uri pointing here.
# Reverie does not host a reporter — operator typically points this at a log
# aggregator (Loki push API, Sentry CSP endpoint, or similar).
REVERIE_CSP_REPORT_ENDPOINT=

# Enable Strict-Transport-Security header (only safe when a TLS-terminating
# proxy sits in front of Reverie). Accepts 'true' / 'false'.
REVERIE_BEHIND_HTTPS=false

# Append '; includeSubDomains' to HSTS value.
# FOOTGUN: this locks every sibling subdomain of Reverie's host into
# HTTPS-only for max-age seconds — enable only on dedicated-apex deployments.
# Requires REVERIE_BEHIND_HTTPS=true.
REVERIE_HSTS_INCLUDE_SUBDOMAINS=false

# Append '; preload' to HSTS value. For HSTS-preload-list submission.
# Requires REVERIE_BEHIND_HTTPS=true and REVERIE_HSTS_INCLUDE_SUBDOMAINS=true.
REVERIE_HSTS_PRELOAD=false

# ---------------------------------------------------------------------------
# Dev server (frontend) — only consumed by `npm run dev`
# ---------------------------------------------------------------------------
# Comma-separated list of non-loopback hostnames the Vite dev server
# accepts in the request `Host` header. Bounds Vite's DNS-rebinding
# guard. Loopback hosts (localhost, *.localhost, any IP literal) are
# always accepted regardless. See frontend/AGENTS.md.
# REVERIE_DEV_HOSTS=dev.example.com

# Override the HMR websocket reconnect port. Set when fronting the dev
# server with a reverse proxy on a different external port (e.g. a
# Cloudflare tunnel terminating TLS at 443) — without it the browser
# tries `wss://<host>:5173/` and the proxy does not forward it.
# REVERIE_DEV_HMR_CLIENT_PORT=443

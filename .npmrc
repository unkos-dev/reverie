; Never put credentials in this file. It is tracked, and `.npmrc` is where npm
; expects `_authToken`. Registry auth belongs in the user-level ~/.npmrc.
;
; Install-script policy, recorded in
; adr/2026-08-03-package-ingress-default-deny.md. `allowScripts` in the root
; package.json rules on each dependency that ships an install script; npm
; blocks anything unreviewed on its own, and this setting stops the install
; instead, so a dependency that starts shipping a script is a decision rather
; than a warning nobody reads.
;
; Entries denied with `false` are skipped in silence and are unaffected, as are
; runs under `--ignore-scripts` or `--dangerously-allow-all-scripts`. `npm exec`
; and `npx` are a rough edge: they ignore the project allowScripts by design but
; still read this setting, so an ad-hoc `npx <tool>` whose package has an
; install script needs `--allow-scripts=<tool>`. The image build is out of scope
; twice over, copying only the manifests and the lockfile, never this file, and
; passing `--ignore-scripts` on every install it runs.
strict-allow-scripts=true

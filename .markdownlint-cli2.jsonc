{
  "config": {
    "default": true,
    "MD004": { "style": "dash" },
    "MD013": false,
    // Specification artifacts carry the title in frontmatter and as the H1.
    "MD025": { "front_matter_title": "" },
    "MD033": false,
  },
  "ignores": [
    "node_modules",
    "target",
    "CHANGELOG.md",
    ".claude/**",
    "docs/security/codeguard/**",
    "CLAUDE.md",
    "**/CLAUDE.md",
  ],
}

# Normalize all text to LF in the repo and on checkout (incl. Windows),
# so prettier's endOfLine:lf and CRLF-on-checkout never fight.
* text=auto eol=lf

# Binary assets — never touch line endings or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.epub  binary
*.zip   binary

# Vendored Vale spelling dictionary (Australian English Hunspell data): a 50k-word
# list, not authored source. Keep it out of language stats and suppress its diff
# so it never dominates a review.
styles/config/dictionaries/en_AU.dic linguist-vendored linguist-generated -diff
styles/config/dictionaries/en_AU.aff linguist-vendored linguist-generated -diff

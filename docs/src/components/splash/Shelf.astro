---
/**
 * The hero scene: a shelf of book spines with one empty slot, glowing gold.
 * This is the brand mark's origin story drawn literally (the Slot is the
 * negative space of a bookshelf), so every colour is a dark sand/gold ramp
 * step or a brand constant; nothing here is decorative freehand colour.
 * The scene is decorative to assistive tech: the heading copy carries the
 * meaning, so the SVG is aria-hidden.
 */
---

<div class="shelf">
  <svg
    viewBox="0 0 1200 300"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <radialGradient id="slot-glow" cx="0.5" cy="0.86" r="0.62">
        <stop offset="0" stop-color="#c9a961" stop-opacity="0.72"></stop>
        <stop offset="0.45" stop-color="#c9a961" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="#c9a961" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="slot-shaft" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#c9a961" stop-opacity="0.3"></stop>
        <stop offset="1" stop-color="#c9a961" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <!-- The glow breathes; everything else holds still. -->
    <g class="glow">
      <rect x="352" y="90" width="380" height="178" fill="url(#slot-glow)"></rect>
      <rect x="500" y="90" width="84" height="178" fill="url(#slot-shaft)"></rect>
    </g>

    <!-- Left run of spines -->
    <g>
      <rect x="80" y="118" width="22" height="150" fill="#24221e"></rect>
      <rect x="104" y="83" width="30" height="185" fill="#1b1812"></rect>
      <rect x="136" y="103" width="18" height="165" fill="#2b2924"></rect>
      <rect x="143" y="126" width="2" height="14" fill="#e8e0d0" opacity="0.3"></rect>
      <rect x="156" y="68" width="34" height="200" fill="#262217"></rect>
      <rect x="156" y="68" width="34" height="3" fill="#4b3e1f"></rect>
      <rect x="192" y="96" width="24" height="172" fill="#34302a"></rect>
      <rect x="218" y="110" width="16" height="158" fill="#24221e"></rect>
      <rect x="224" y="134" width="2" height="12" fill="#e8e0d0" opacity="0.28"></rect>
      <rect
        x="240"
        y="78"
        width="26"
        height="190"
        fill="#312a1a"
        transform="rotate(-6, 253, 268)"></rect>
      <rect x="272" y="58" width="38" height="210" fill="#24221e"></rect>
      <rect x="283" y="88" width="2" height="16" fill="#e8e0d0" opacity="0.32"></rect>
      <rect x="312" y="90" width="20" height="178" fill="#2b2924"></rect>
      <rect x="312" y="90" width="20" height="3" fill="#5f4d22"></rect>
      <!-- A short stack lying flat -->
      <rect x="340" y="252" width="92" height="16" fill="#262217"></rect>
      <rect x="344" y="236" width="84" height="16" fill="#1b1812"></rect>
      <rect x="350" y="222" width="72" height="14" fill="#312a1a"></rect>
      <rect x="448" y="76" width="28" height="192" fill="#34302a"></rect>
      <rect x="459" y="104" width="2" height="14" fill="#e8e0d0" opacity="0.3"></rect>
      <rect x="478" y="118" width="18" height="150" fill="#24221e"></rect>
    </g>

    <!-- The Slot: the one gap in the run, lit from within -->
    <rect x="506" y="258" width="72" height="4" rx="1" fill="#c9a961"></rect>

    <!-- Right run of spines; the first book leans toward the gap -->
    <g>
      <rect
        x="592"
        y="82"
        width="28"
        height="186"
        fill="#262217"
        transform="rotate(-9, 606, 268)"></rect>
      <rect x="630" y="98" width="24" height="170" fill="#1b1812"></rect>
      <rect x="639" y="124" width="2" height="14" fill="#e8e0d0" opacity="0.28"></rect>
      <rect x="656" y="70" width="32" height="198" fill="#2b2924"></rect>
      <rect x="656" y="70" width="32" height="3" fill="#4b3e1f"></rect>
      <rect x="690" y="108" width="16" height="160" fill="#34302a"></rect>
      <rect x="708" y="86" width="26" height="182" fill="#24221e"></rect>
      <rect x="718" y="112" width="2" height="16" fill="#e8e0d0" opacity="0.32"></rect>
      <rect x="736" y="62" width="36" height="206" fill="#262217"></rect>
      <rect x="774" y="100" width="20" height="168" fill="#312a1a"></rect>
      <rect x="796" y="78" width="28" height="190" fill="#1b1812"></rect>
      <rect x="796" y="78" width="28" height="3" fill="#5f4d22"></rect>
      <rect x="826" y="116" width="18" height="152" fill="#24221e"></rect>
      <!-- A pair lying flat -->
      <rect x="852" y="254" width="88" height="14" fill="#2b2924"></rect>
      <rect x="858" y="240" width="76" height="14" fill="#262217"></rect>
      <rect x="952" y="80" width="30" height="188" fill="#24221e"></rect>
      <rect x="963" y="108" width="2" height="14" fill="#e8e0d0" opacity="0.3"></rect>
      <rect x="984" y="102" width="22" height="166" fill="#34302a"></rect>
      <rect x="1008" y="70" width="34" height="198" fill="#1b1812"></rect>
      <rect x="1008" y="70" width="34" height="3" fill="#4b3e1f"></rect>
      <rect x="1044" y="112" width="18" height="156" fill="#262217"></rect>
      <rect x="1064" y="88" width="26" height="180" fill="#2b2924"></rect>
    </g>

    <!-- Shelf board -->
    <rect x="0" y="268" width="1200" height="3" fill="#3e3a32"></rect>
    <rect x="0" y="271" width="1200" height="1" fill="#191815"></rect>
  </svg>
</div>

<style>
  .shelf {
    width: 100%;
    aspect-ratio: 4 / 1;
    min-height: 230px;
    max-height: 280px;
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .shelf svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .glow {
    animation: rv-breathe 5.5s ease-in-out infinite alternate;
  }

  @keyframes rv-breathe {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
      opacity: 0.85;
    }
  }
</style>

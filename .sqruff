[sqruff]
dialect = postgres
templater = raw

rules = all
# LT02 is excluded pending quarylabs/sqruff#2747: on a file this size sqruff
# reports CREATE TABLE bodies as needing no indentation. SQLFluff still enforces
# it via Codacy, so indentation stays checked.
exclude_rules = AL07,ST05,ST06,LT02

output_line_length = 120
max_line_length = 120

warn_unused_ignores = True

# Lint files regardless of size.
large_file_skip_char_limit = 0
large_file_skip_byte_limit = 0


[sqruff:dialect:postgres]
pg_trgm = true


[sqruff:indentation]
indent_unit = space
tab_space_size = 4


[sqruff:rules]
single_table_references = unqualified


[sqruff:rules:capitalisation.keywords]
capitalisation_policy = upper


[sqruff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower


[sqruff:rules:capitalisation.functions]
extended_capitalisation_policy = lower


[sqruff:rules:capitalisation.literals]
capitalisation_policy = upper


[sqruff:rules:capitalisation.types]
extended_capitalisation_policy = lower


[sqruff:rules:ambiguous.column_references]
# Avoid positional GROUP BY / ORDER BY references.
group_by_and_order_by_style = explicit


[sqruff:rules:convention.casting_style]
# Prefer PostgreSQL-native casts.
preferred_type_casting_style = shorthand


[sqruff:rules:convention.not_equal]
preferred_not_equal_style = ansi

# Reverie's migrations are Postgres DDL applied by sqlx. Without an explicit
# dialect SQLFluff parses them as ANSI SQL and reports valid Postgres syntax as
# parse errors, which buries any genuine finding under noise.
[sqlfluff]
dialect = postgres

# sqlx applies migration files literally and checksums them, so there is no
# templating layer for SQLFluff to expand. The default Jinja templater would
# declare a rendering step that does not exist, and would fail any future
# migration whose string literals contain a Jinja delimiter.
templater = raw

[sqlfluff:indentation]
# Mirrors .editorconfig, which gives SQL the unqualified four-space indent.
tab_space_size = 4

# Every other rule is left at its default on purpose. The point of running
# SQLFluff is to learn which conventions it argues for; pre-tuning the rule set
# to the current house style would only confirm what the migrations already do.

# Config for Codacy's hosted SQLFluff analysis, mirroring `.sqruff`. Keep the
# two in step by hand. While Codacy is set to read this file its own per-rule
# toggles are inert, so rule selection has to happen here.
[sqlfluff]
dialect = postgres
templater = raw

rules = all
exclude_rules = AL07,ST05,ST06

output_line_length = 120
max_line_length = 120

warn_unused_ignores = True

# Lint files regardless of size.
large_file_skip_char_limit = 0
large_file_skip_byte_limit = 0


[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4


[sqlfluff:rules]
single_table_references = unqualified


[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper


[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower


[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower


[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper


[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower


[sqlfluff:rules:ambiguous.column_references]
# Avoid positional GROUP BY / ORDER BY references.
group_by_and_order_by_style = explicit


[sqlfluff:rules:convention.casting_style]
# Prefer PostgreSQL-native casts.
preferred_type_casting_style = shorthand


[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = ansi

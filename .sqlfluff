# Config for Codacy's hosted SQLFluff analysis. Local linting uses sqruff and
# `.sqruff`; the two files are kept consistent by hand.
[sqlfluff]
# Without an explicit dialect, Postgres DDL parses as ANSI SQL and valid syntax
# is reported as parse errors.
dialect = postgres
# sqlx applies migration files literally, so no templating layer exists. The
# default Jinja templater would fail any migration whose string literals
# contain a Jinja delimiter.
templater = raw
max_line_length = 120

[sqlfluff:indentation]
# Mirrors .editorconfig, which gives SQL the unqualified four-space indent.
tab_space_size = 4

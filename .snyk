# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-URIJS-19963963:
    - eslint > ajv > uri-js:
        reason: >-
          Reached only through ESLint's ajv 6, which compiles the rule-option
          schemas ESLint and its plugins ship; no input from outside the
          repository reaches uri-js, and no fixed uri-js release exists.

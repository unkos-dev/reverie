.git
.github
.gitignore
.vscode
.idea
# docs is excluded except its manifest: pnpm needs every project's
# package.json to resolve the workspace graph (the frontend-builder stage
# installs only the frontend project's deps). `docs/*` rather than a bare
# `docs` so the negation matches at the child level instead of relying on
# the builder walking into an excluded parent directory.
docs/*
!docs/package.json
target
node_modules
dist
# Static-guard allowlists are lint policy read by scripts/backend-guards.sh,
# never build input.
backend/guards
# User library/ingestion/quarantine data, when a dev override points a config
# path (REVERIE_LIBRARY_PATH etc.) inside the checkout. Never build input,
# and keeps user-uploaded content out of the build context.
backend/library
backend/ingestion
backend/quarantine
*.md
!README.md
LICENSE

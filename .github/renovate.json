{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":gitSignOff",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "timezone": "Australia/Perth",
  "dependencyDashboardTitle": "Dependency dashboard: Renovate",
  "labels": ["dependencies"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"],
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "Update lockfiles within compatible cargo and npm ranges; replace ranges for incompatible releases.",
      "matchManagers": ["cargo", "npm"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Hold major upgrades for dashboard approval and process them after lower-risk updates.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "prPriority": -10
    },
    {
      "description": "Pin Docker base images by digest for reproducible, tamper-evident builds.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Automerge patch, pin, and digest updates for Docker Official Images after required checks pass.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Treat GitHub-owned actions as platform dependencies and automerge patch, pin, and digest updates after required checks pass.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["actions/**", "github/**"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge third-party action patch and pin updates; require manual review when a pinned tag moves to a new digest.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "pin"],
      "automerge": true
    },
    {
      "description": "Automerge stable cargo and npm patch updates; keep pre-1.0 updates manual.",
      "matchManagers": ["cargo", "npm"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    },
    {
      "description": "Group compatible React packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "react"
    },
    {
      "description": "Group compatible Tailwind CSS packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tailwindcss"
    },
    {
      "description": "Group compatible TanStack Query packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@tanstack/react-query", "@tanstack/react-query-devtools"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "tanstack-query"
    },
    {
      "description": "Group compatible commitlint packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@commitlint/cli", "@commitlint/config-conventional"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "commitlint"
    },
    {
      "description": "Keep development and staging PostgreSQL image updates together.",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "postgres-images"
    },
    {
      "description": "Keep the SQLx library and migration CLI compatible.",
      "matchDepNames": ["sqlx", "sqlx-cli"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "sqlx"
    },
    {
      "description": "Group compatible Astro documentation packages.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["astro", "@astrojs/starlight", "starlight-openapi"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "astro-docs"
    },
    {
      "description": "Ignore rand_core_06 because the alias intentionally targets the 0.6 API.",
      "matchManagers": ["cargo"],
      "matchDepNames": ["rand_core_06"],
      "enabled": false
    },
    {
      "description": "Keep vite-plus and vitest in lockstep: vite-plus bundles the @vitest/* family with an exact vitest peer dependency, so a standalone vitest or vite-plus bump fails lockfile resolution.",
      "matchDepNames": ["vite-plus", "vite", "@voidzero-dev/**", "vitest", "@vitest/**"],
      "groupName": "vite-plus"
    },
    {
      "description": "The generated color primitives pin these exactly; any bump fails the radix-gen drift test until npm run primitives:gen is rerun and the palette diff reviewed, so move them as one deliberate, dashboard-approved group.",
      "matchDepNames": ["@radix-ui/colors", "colorjs.io", "bezier-easing"],
      "groupName": "radix-gen",
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "Track inline Rust tool versions that the GitHub Actions manager cannot detect.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>cargo-nextest|cargo-llvm-cov|cargo-deny|cargo-machete|cargo-mutants)@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "description": "Track SQLX_CLI_VERSION because it is not embedded in an install-action tool list.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["SQLX_CLI_VERSION:\\s*\"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "sqlx-cli",
      "datasourceTemplate": "crate"
    },
    {
      "description": "Track checksum-verified lint tools; version bumps require the corresponding checksum to be updated manually.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Track annotated version pins in workflows (TruffleHog's image tag, mise itself, and the remaining install-pinned-tool binaries). When a sha256 line follows the version, the github-release-attachments datasource rewrites it alongside the bump, keeping the checksum control without the manual repin step.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+version:\\s*\"(?<currentValue>[^\"]+)\"(?:\\s+sha256:\\s*\"(?<currentDigest>[a-f0-9]{64})\")?"
      ]
    }
  ]
}
